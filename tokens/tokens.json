{
  "$description": "Kora: fuente única de tokens. Las primitivas (paleta) NO se usan en componentes; solo los tokens semánticos y las escalas. tokens.css se genera con: npm run tokens:build",
  "primitive": {
    "gray": {
      "0": "#FFFFFF", "50": "#F7F7F9", "100": "#EEEFF3", "200": "#DDDFE6", "300": "#C3C6D1",
      "500": "#7A7F90", "600": "#5A5F70", "700": "#3F4352", "800": "#2A2D3A", "900": "#1B1D27", "950": "#12131A"
    },
    "indigo": { "300": "#A5ACFF", "400": "#8C95FF", "600": "#4553E6", "700": "#3640C0" },
    "red":    { "100": "#FDE3E3", "300": "#F4A3A9", "400": "#FF8A92", "600": "#D92D3A", "700": "#B3202D", "800": "#8E1B26", "950": "#330A0E" },
    "green":  { "100": "#DDF5E6", "300": "#8FE0B1", "800": "#14532D", "950": "#0C2A1A" },
    "amber":  { "100": "#FFF1D1", "300": "#FFD27A", "800": "#7A4A00", "950": "#2E1D00" }
  },
  "semantic": {
    "surface-base":          { "light": "{primitive.gray.50}",   "dark": "{primitive.gray.950}", "use": "Fondo de la página. Nada se dibuja por debajo." },
    "surface-raised":        { "light": "{primitive.gray.0}",    "dark": "{primitive.gray.900}", "use": "Todo lo que se apoya SOBRE la base: tarjetas, paneles, campos, modales." },
    "border-subtle":         { "light": "{primitive.gray.200}",  "dark": "{primitive.gray.800}", "use": "Separadores y bordes de contenedores." },
    "border-strong":         { "light": "{primitive.gray.500}",  "dark": "{primitive.gray.500}", "use": "Bordes de elementos interactivos (campos, botón secundario)." },
    "text-primary":          { "light": "{primitive.gray.950}",  "dark": "{primitive.gray.50}",  "use": "Texto principal." },
    "text-muted":            { "light": "{primitive.gray.600}",  "dark": "{primitive.gray.300}", "use": "Texto secundario, ayudas, etiquetas." },
    "text-inverse":          { "light": "{primitive.gray.0}",    "dark": "{primitive.gray.950}", "use": "Texto sobre action-primary y action-danger." },
    "action-primary":        { "light": "{primitive.indigo.600}", "dark": "{primitive.indigo.400}", "use": "Fondo de la acción principal." },
    "action-primary-hover":  { "light": "{primitive.indigo.700}", "dark": "{primitive.indigo.300}", "use": "Hover de la acción principal." },
    "action-danger":         { "light": "{primitive.red.600}",   "dark": "{primitive.red.400}",  "use": "Fondo de una acción destructiva." },
    "action-danger-hover":   { "light": "{primitive.red.700}",   "dark": "{primitive.red.300}",  "use": "Hover de una acción destructiva." },
    "feedback-success-bg":   { "light": "{primitive.green.100}", "dark": "{primitive.green.950}", "use": "Fondo de estado correcto." },
    "feedback-success-text": { "light": "{primitive.green.800}", "dark": "{primitive.green.300}", "use": "Texto de estado correcto." },
    "feedback-warning-bg":   { "light": "{primitive.amber.100}", "dark": "{primitive.amber.950}", "use": "Fondo de aviso." },
    "feedback-warning-text": { "light": "{primitive.amber.800}", "dark": "{primitive.amber.300}", "use": "Texto de aviso." },
    "feedback-danger-bg":    { "light": "{primitive.red.100}",   "dark": "{primitive.red.950}",  "use": "Fondo de error." },
    "feedback-danger-text":  { "light": "{primitive.red.800}",   "dark": "{primitive.red.300}",  "use": "Texto de error." },
    "focus-ring":            { "light": "{primitive.indigo.600}", "dark": "{primitive.indigo.300}", "use": "Anillo de foco. Nunca se quita." }
  },
  "scale": {
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "32px", "8": "48px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px", "full": "999px" },
    "font-size": { "sm": "14px", "md": "16px", "lg": "20px", "xl": "28px" },
    "font-weight": { "regular": "400", "medium": "500", "bold": "700" },
    "line-height": { "tight": "1.25", "normal": "1.5" },
    "shadow": { "sm": "0 1px 2px rgba(18, 19, 26, 0.08)", "md": "0 4px 12px rgba(18, 19, 26, 0.12)" },
    "font-family": { "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
  }
}
